# no-littering: all redirected package state lands under these two dirs.
# var/ = volatile runtime state (autosaves, recentf, savehist, transient
# history, tramp, eln-cache crumbs, ...); etc/ = config-ish data.  These two
# lines supersede most of the per-file rules below — once the orphaned
# pre-no-littering files at the repo root are removed, those rules can go too.
/var/
/etc/

# Package manager downloads — re-installed by use-package on first run
/elpa/

# Native-compilation (eln) cache — regenerated by Emacs
/eln-cache/

# Editor / runtime state — not config
/auto-save-list/
/transient/
/tramp
/history
/.cache/
/url/
/recentf
/places
/projects
/bookmarks
/savehist
/eshell/

# Package state that doesn't go through no-littering (lands at the repo root):
# treesit-auto's downloaded tree-sitter grammars (.so) and elgrep's last-search
# cache — both regenerated on demand.
/tree-sitter/
/elgrep-data.el

# Backups Emacs / our own scripts leave behind
*~
*.bak
*.bak-*
\#*\#
.\#*

# Byte-compiled / native-compiled artifacts
*.elc
*.eln
.aider*
