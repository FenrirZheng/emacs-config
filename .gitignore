# Package manager downloads — re-installed by use-package on first run
/elpa/

# Native-compilation (eln) cache — regenerated by Emacs
/eln-cache/

# Editor / runtime state — not config
/auto-save-list/
/transient/
/tramp
/history
/.cache/
/url/
/recentf
/places
/projects
/bookmarks
/savehist
/eshell/

# eca: vendored 78 MB binary + zip, not config
/eca/

# Backups Emacs / our own scripts leave behind
*~
*.bak
*.bak-*
\#*\#
.\#*

# Byte-compiled / native-compiled artifacts
*.elc
*.eln
