# no-littering: all redirected package state lands under these two dirs.
# var/ = volatile runtime state (autosaves, recentf, savehist, transient
# history, tramp, eln-cache crumbs, ...); etc/ = config-ish data.  These two
# lines supersede most of the per-file rules below — once the orphaned
# pre-no-littering files at the repo root are removed, those rules can go too.
/var/
/etc/

# Package manager downloads — re-installed by use-package on first run
/elpa/

# Native-compilation (eln) cache — regenerated by Emacs
/eln-cache/

# Claude Code per-session runtime lock (live sessionId/pid/timestamp) — not config
/.claude/scheduled_tasks.lock

# Editor / runtime state — not config
/auto-save-list/
/transient/
/tramp
/history
/.cache/
/url/
/recentf
/places
/projects
/bookmarks
/savehist
/eshell/

# Package state that doesn't go through no-littering (lands at the repo root):
# treesit-auto's downloaded tree-sitter grammars (.so), regenerated on demand.
/tree-sitter/
# elgrep IS redirected by no-littering (var/elgrep-data.el); the root copy is a
# pre-no-littering orphan that was deleted 2026-08 — the rule stays as a guard
# in case an elgrep version ever writes to the default location again.
/elgrep-data.el

# Backups Emacs / our own scripts leave behind
*~
*.bak
*.bak-*
\#*\#
.\#*

# Byte-compiled / native-compiled artifacts
*.elc
*.eln
.aider*

# cpp/ C++ libraries workspace: build outputs (rebuilt by cpp/build.sh).
# Per-module sources (cpp/<name>/{src,vendor,CMakeLists.txt}) stay tracked.
/cpp/build/
/cpp/lib/

# rust/ tooling workspace: per-subproject cloned upstream source + build
# outputs (rebuilt by `make` in each subproject). The aggregator Makefile, the
# per-subproject Makefiles, and the READMEs stay tracked.
/rust/treesit-grammar/tree-sitter-rust/
/rust/treesit-grammar/build/
/rust/treesit-grammar-c/tree-sitter-c/
/rust/treesit-grammar-c/build/
/rust/treesit-grammar-lua/tree-sitter-lua/
/rust/treesit-grammar-lua/build/
# deployed dynamic modules (workspace-wide, like cpp/lib/) + cargo target dir.
/rust/lib/
/rust/question-queue-core/target/
# GNU Global index built ad-hoc inside subprojects (generated, not tracked).
/rust/*/GTAGS
/rust/*/GRTAGS
/rust/*/GPATH
