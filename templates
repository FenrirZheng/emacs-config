;;; -*- mode: lisp-data; -*-
;;
;; TempEl templates -- the `tempel-path' file for this config.
;; Syntax (tempo/tempel, NOT yasnippet): "lit" string | p field | (p "PROMPT")
;; | (p "DEFAULT" name) named field | (s name) mirror | r / r> region-or-field
;; | n newline | > indent | n> newline+indent | q final cursor | & bol-newline.
;; Any other Lisp form is evaluated and its string result inserted.
;;
;; A bare symbol line sets the major-mode(s) the following templates apply to;
;; `fundamental-mode' templates are GLOBAL (available in every buffer).
;; Companion config: lisp/init-snippets.el.  Cheat sheet: FEATURES.md.

fundamental-mode

;; Global, mode-agnostic helpers -- date/time stamps, dividers, plain tags.
(today (format-time-string "%Y-%m-%d"))
(now (format-time-string "%Y-%m-%d %H:%M"))
(nowtz (format-time-string "%Y-%m-%d %H:%M %z"))
(time (format-time-string "%H:%M:%S"))
(iso (format-time-string "%Y-%m-%dT%H:%M:%S%z"))
(stamp (format-time-string "%Y-%m-%d %H:%M") " " p)
(date (format-time-string "%Y%m%d"))
(div (or comment-start "") "----------------------------------------" n)
(box (or comment-start "") " " (make-string 60 ?=) n (or comment-start "") " " (p "title") n (or comment-start "") " " (make-string 60 ?=) n)
(sep (make-string 72 ?-))
(todo (or comment-start "") " TODO: " p)
(fixme (or comment-start "") " FIXME: " p)

prog-mode

;; Comment-tag templates -- adapt to the buffer's language via comment-start.
;; (todo/fixme/sep live in fundamental-mode above, available here globally.)
(note (if (> (length comment-start) 0) comment-start "# ") "NOTE: " p)
(hack (if (> (length comment-start) 0) comment-start "# ") "HACK: " p)
(xxx (if (> (length comment-start) 0) comment-start "# ") "XXX: " p)
(bug (if (> (length comment-start) 0) comment-start "# ") "BUG: " p)
(optimize (if (> (length comment-start) 0) comment-start "# ") "OPTIMIZE: " p)
(noteauthor (if (> (length comment-start) 0) comment-start "# ") "NOTE(" (user-login-name) "): " p)
(todoauthor (if (> (length comment-start) 0) comment-start "# ") "TODO(" (user-login-name) "): " p)
(datedtodo (if (> (length comment-start) 0) comment-start "# ") "TODO(" (format-time-string "%Y-%m-%d") "): " p)
(banner (if (> (length comment-start) 0) comment-start "# ") (make-string 60 ?=) n (if (> (length comment-start) 0) comment-start "# ") " " (p "Section") n (if (> (length comment-start) 0) comment-start "# ") (make-string 60 ?=) q)

emacs-lisp-mode

(header ";;; " (file-name-base (or (buffer-file-name) (buffer-name))) ".el --- " (p "summary") " -*- lexical-binding: t; -*-" n n ";;; Commentary:" n ";; " p n n ";;; Code:" n n q)
(provide "(provide '" (file-name-base (or (buffer-file-name) (buffer-name))) ")" n ";;; " (file-name-base (or (buffer-file-name) (buffer-name))) ".el ends here" n)
(defun "(defun " (p "name") " (" p ")" n> "\"" p "\"" n> r> ")")
(cmd "(defun " (p "name") " (" p ")" n> "\"" p "\"" n> "(interactive)" n> r> ")")
(defvar "(defvar " (p "name") " " (p "value") n> "\"" p "\")")
(defcustom "(defcustom " (p "name") " " (p "value") n> "\"" p "\"" n> ":type 'boolean" n> ":group '" p ")")
(let "(let ((" (p "var") " " (p "val") "))" n> r> ")")
(lets "(let* ((" (p "var") " " (p "val") "))" n> r> ")")
(use "(use-package " (p "pkg") n> ":ensure " (p "t") n> r> ")")
(weval "(with-eval-after-load '" (p "feature") n> r> ")")
(hook "(add-hook '" (p "mode") "-hook #'" p ")")
(dolist "(dolist (" (p "x") " " (p "list") ")" n> r> ")")
(when "(when " (p "cond") n> r> ")")
(setf "(setf (alist-get " (p ":key") " " (p "alist") ") " p ")")

go-ts-mode

(func "func " (p "name") "(" p ") " p " {" n> r> n "}" n)
(meth "func (" (p "r") " " (p "Type") ") " (p "name") "(" p ") " p " {" n> r> n "}" n)
(struct "type " (p "Name" name) " struct {" n> p n "}" n n "func New" (s name) "(" p ") *" (s name) " {" n> "return &" (s name) "{" p "}" n "}" n)
(iface "type " (p "Name") " interface {" n> p n "}" n)
(iferr "if err != nil {" n> "return " p n "}" q)
(wraperr "return fmt.Errorf(\"" (p "context") ": %w\", err)" q)
(test "func Test" (p "Name" name) "(t *testing.T) {" n> "tests := []struct {" n> "name string" n> p n "}{" n> p n "}" n> "for _, tt := range tests {" n> "t.Run(tt.name, func(t *testing.T) {" n> p n "})" n> "}" n "}" n)
(main "func main() {" n> r> q n "}" n)
(pkg "package " (p (file-name-base (or (buffer-file-name) "main"))) n n "import (" n> p n ")" n)
(goroutine "go func() {" n> r> q n "}()" n)
(chan (p "ch") " := make(chan " (p "T") ")" q)
(defer "defer " p q)
(println "fmt.Println(" r> ")" q)
;; loops (Go has only `for' -- four idioms)
(for "for " (p "i" i) " := 0; " (s i) " < " (p "n") "; " (s i) "++ {" n> r> n "}" q)
(forr "for " (p "i") ", " (p "v") " := range " (p "coll") " {" n> r> n "}" q)
(forc "for " (p "cond") " {" n> r> n "}" q)
(forinf "for {" n> r> n "}" q)

python-ts-mode python-mode

;; functions / methods
(def "def " (p "name") "(" p ")" (p " -> None") ":" n> "\"\"\"" p "\"\"\"" n> r> q)
(adef "async def " (p "name") "(" p ")" (p " -> None") ":" n> r> q)
(m "def " (p "name") "(self" (p ", ") ")" (p " -> None") ":" n> r> q)
;; classes
(class "class " (p "Name" cname) ":" n> "\"\"\"" p "\"\"\"" n n> "def __init__(self" (p ", ") ") -> None:" n> r> q)
(dataclass "@dataclass" n "class " (p "Name") ":" n> (p "field") ": " (p "type") n> q)
;; entrypoint
(main "def main() -> None:" n> r> q n n "if __name__ == \"__main__\":" n> "main()")
(ifmain "if __name__ == \"__main__\":" n> q)
;; tests / fixtures
(test "def test_" (p "name") "() -> None:" n> r> q)
(fixture "@pytest.fixture" n "def " (p "name") "():" n> r> "return " p n> q)
(param "@pytest.mark.parametrize(\"" (p "arg" a) "\", [" p "])" n "def test_" (p "name") "(" (s a) ") -> None:" n> r> q)
;; control flow / error handling
(try "try:" n> r> "except " (p "Exception") " as " (p "e") ":" n> q)
(tryf "try:" n> r> "except " (p "Exception") " as " (p "e") ":" n> p n> "finally:" n> q)
(with "with " (p "expr") " as " (p "f") ":" n> r> q)
(forr "for " (p "item" it) " in " (p "iterable") ":" n> r> q)
(whilet "while " (p "cond") ":" n> r> q)
;; comprehensions
(lc "[" (p "expr") " for " (p "x" x) " in " (p "iterable") "]" q)
(dc "{" (p "k") ": " (p "v") " for " (p "x" x) " in " (p "iterable") "}" q)
;; logging / strings
(log (p "logger") "." (p "info") "(f\"" p "\")" q)
(fstr "f\"" p "\"" q)
;; docstrings (Google style)
(doc "\"\"\"" (p "summary") "." n n "Args:" n> (p "name") ": " (p "desc") n n "Returns:" n> (p "desc") n n "Raises:" n> (p "Error") ": " (p "when") n "\"\"\"" q)
;; imports
(imp "import " (p "module") q)
(from "from " (p "module") " import " (p "names") q)

rust-ts-mode

