(guard "#ifndef " (p (upcase (concat (file-name-base (or (buffer-file-name) (buffer-name))) "_h")) name t) "#define " (s name) n n r n n "#endif /* " (s name) " */")
(def "#define " (p "MACRO") " " p)
(pragma "#pragma once" n)
;; --- functions ---
(fun (p "void" ret) " " (p "name") "(" p ")" n "{" n> r> q n "}")
(main "int main(int argc, char **argv)" n "{" n> r> q n> "return 0;" n "}")
;; --- types ---
(struct "struct " (p "Name" name) " {" n> p n "};" n "typedef struct " (s name) " " (s name) ";")
(enum "enum " (p "Name") " {" n> p n "};")
;; --- C++ class (name mirrored in ctor/dtor) ---
(class "class " (p "Name" name) " {" n "public:" n> (s name) "(" p ");" n> "~" (s name) "();" n n "private:" n> q n "};")
(ns "namespace " (p "name" name) " {" n n> r> q n n "}  // namespace " (s name))
;; --- control flow ---
(for "for (" (p "int i = 0") "; " (p "i < n") "; " (p "++i") ") {" n> r> q n "}")
(forr "for (size_t " (p "i" i) " = 0; " (s i) " < " (p "n") "; ++" (s i) ") {" n> r> q n "}")
(fore "for (const auto& " (p "x") " : " (p "container") ") {" n> r> q n "}")
(while "while (" (p "cond") ") {" n> r> q n "}")
(ifel "if (" (p "cond") ") {" n> p n "} else {" n> p n "}")
(sw "switch (" (p "x") ") {" n "case " (p "v") ":" n> p n> "break;" n "default:" n> p n> "break;" n "}")
;; --- output ---
(pf "printf(\"" (p "%d") "\\n\", " p ");")
(cout "std::cout << " (p "x") " << std::endl;")
