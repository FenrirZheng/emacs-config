(vec "std::vector<" (p "int") "> " (p "v") ";")
(iter "for (auto it = " (p "v" v) ".begin(); it != " (s v) ".end(); ++it) {" n> r> q n "}")
;; --- doc comment block ---
(doc "/**" n " * " (p "summary") n " *" n " * @param " p n " * @return " p n " */")

