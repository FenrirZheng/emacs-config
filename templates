markdown-mode gfm-mode

;; fenced code block with language placeholder
(code "```" (p "lang") n> r> n> "```" n q)
;; inline link -- [label](path) per user convention
(link "[" (p "label") "](" (p "path") ")" q)
;; image
(img "![" (p "alt") "](" (p "path") ")" q)
;; table skeleton (2 columns)
(table "| " (p "col1") " | " (p "col2") " |" n "| --- | --- |" n "| " p " | " p " |" n q)
;; task list item
(task "- [ ] " (p "task") q)
;; details/summary collapsible (HTML)
(details "<details>" n "<summary>" (p "summary") "</summary>" n n r> n n "</details>" n q)
;; front-matter YAML block
(fm "---" n "title: " (p "title") n "date: " (format-time-string "%Y-%m-%d") n "tags: [" p "]" n "---" n q)
;; heading with explicit anchor id
(ha "## " (p "Heading") " {#" (p "anchor") "}" n q)
;; blockquote
(bq "> " r q)
;; footnote reference + definition
(fn "[^" (p "id" id) "]" n "[^" (s id) "]: " (p "note") q)
;; bold / italic wrappers around region
(b "**" r "**" q)
(i "*" r "*" q)

